{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-gpu": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local GPU (Qwen3.6-35B-A3B)",
      "options": {
        "baseURL": "http://127.0.0.1:8901/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "qwen3.6-35b-a3b-gpu": {
          "name": "Qwen3.6 35B A3B (GPU, llama.cpp)",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "interleaved": "reasoning_content"
        },
        "qwen3.6-35b-a3b-gpu-thinking": {
          "name": "Qwen3.6 35B A3B (GPU, thinking mode)",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "interleaved": "reasoning_content",
          "options": {
            "chat_template_kwargs": { "enable_thinking": true }
          }
        }
      }
    },
    "local-npu": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local NPU (Qwen2.5-Coder-7B)",
      "options": {
        "baseURL": "http://127.0.0.1:8900/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "qwen2.5-coder-7b-npu": {
          "name": "Qwen2.5-Coder-7B (NPU, OpenVINO)",
          "tool_call": true,
          "reasoning": false,
          "temperature": true
        }
      }
    }
  },
  "model": "local-gpu/qwen3.6-35b-a3b-gpu",
  "small_model": "local-gpu/qwen3.6-35b-a3b-gpu"
}
